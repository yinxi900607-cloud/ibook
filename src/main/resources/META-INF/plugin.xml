<idea-plugin>
    <id>com.yinxi.edgereader</id>
    <name>Edge Reader</name>
    <vendor url="https://github.com/yinxi900607-cloud">yinxi</vendor>
    <description><![CDATA[
        <p>A private, local-first electronic book reader integrated into JetBrains IDEs.</p>
        <p>Edge Reader provides a collapsible reading shelf with secure EPUB, large-file TXT, bounded PDF, Markdown, and local HTML reading, navigation, search, bookmarks, and progress restoration.</p>
    ]]></description>
    <change-notes><![CDATA[
        <p>Edge Reader 0.6.0 targets IntelliJ IDEA 2026.2 and completes the local-first reader MVP.</p>
        <ul>
            <li>TXT, EPUB, PDF, Markdown, and local HTML reading.</li>
            <li>Cross-format search, bookmarks, navigation, themes, and progress restoration.</li>
            <li>Secure EPUB extraction and local HTML resource containment.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Edge Reader" displayType="BALLOON" isLogByDefault="true"/>
        <toolWindow
            id="Edge Reader"
            anchor="right"
            canCloseContents="false"
            factoryClass="com.yinxi.edgereader.toolwindow.EdgeReaderToolWindowFactory"
            icon="/icons/edgeReader.svg"/>
    </extensions>

    <actions>
        <action
            id="com.yinxi.edgereader.actions.ToggleEdgeReader"
            class="com.yinxi.edgereader.actions.ToggleEdgeReaderAction"
            text="Toggle Edge Reader"
            description="Show or hide the Edge Reader tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="alt R"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.yinxi.edgereader.actions.OpenBook"
            class="com.yinxi.edgereader.actions.OpenBookAction"
            text="Open Book in Edge Reader"
            description="Open a local electronic book in Edge Reader"/>
        <action
            id="com.yinxi.edgereader.actions.NextChapter"
            class="com.yinxi.edgereader.actions.NextChapterAction"
            text="Edge Reader: Next Chapter"
            description="Jump to the next chapter"/>
        <action
            id="com.yinxi.edgereader.actions.PreviousChapter"
            class="com.yinxi.edgereader.actions.PreviousChapterAction"
            text="Edge Reader: Previous Chapter"
            description="Jump to the previous chapter"/>
        <action
            id="com.yinxi.edgereader.actions.NextPage"
            class="com.yinxi.edgereader.actions.NextPageAction"
            text="Edge Reader: Next Page"
            description="Show the next PDF page"/>
        <action
            id="com.yinxi.edgereader.actions.PreviousPage"
            class="com.yinxi.edgereader.actions.PreviousPageAction"
            text="Edge Reader: Previous Page"
            description="Show the previous PDF page"/>
        <action
            id="com.yinxi.edgereader.actions.BackToLibrary"
            class="com.yinxi.edgereader.actions.BackToLibraryAction"
            text="Edge Reader: Back to Library"
            description="Return to the Edge Reader library"/>
        <action
            id="com.yinxi.edgereader.actions.AddBookmark"
            class="com.yinxi.edgereader.actions.AddBookmarkAction"
            text="Edge Reader: Add Bookmark"
            description="Save the current reading position"/>
        <action
            id="com.yinxi.edgereader.actions.FocusSearch"
            class="com.yinxi.edgereader.actions.FocusSearchAction"
            text="Edge Reader: Search Current Book"
            description="Search within the current book"/>
    </actions>
</idea-plugin>
